---
import '@fontsource/syne/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { publishedLocales, routeFor, type PageKey, type PublishedLocale } from '../i18n/config';
import '../styles/global.css';

interface Props {
  locale: PublishedLocale;
  page: PageKey;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const canonical = new URL(routeFor(locale, page), Astro.site);
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Nexform',
  url: new URL(routeFor(locale, 'home'), Astro.site).href,
  description,
  knowsLanguage: ['en', 'de', 'nl', 'fr'],
};
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="white" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {publishedLocales.map((code) => <link rel="alternate" hreflang={code} href={new URL(routeFor(code, page), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(routeFor('en', page), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nexform" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');document.documentElement.classList.add('is-booting');</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}
    <ClientRouter />
  </head>
  <body data-locale={locale}>
    <a class="skip-link" href="#main-content"><slot name="skip" /></a>
    <Header locale={locale} page={page} />
    <main id="main-content" transition:animate="none">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      const EXPO = 'cubic-bezier(0.16, 1, 0.3, 1)';
      const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const initPage = () => {
        const root = document.documentElement;
        if (!window.__nexformBooted) {
          window.__nexformBooted = true;
          root.classList.add('is-booting');
          requestAnimationFrame(() => root.classList.add('is-ready'));
          window.setTimeout(() => root.classList.remove('is-booting'), reducedMotion() ? 220 : 1250);
        } else {
          root.classList.add('is-ready');
        }

        document.querySelectorAll('[data-heading-reveal], [data-reveal], [data-reveal-group]').forEach((element) => {
          if (element.getAttribute('data-observed') === 'true') return;
          element.setAttribute('data-observed', 'true');
          const observer = new IntersectionObserver((entries, currentObserver) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const target = entry.target;
              target.classList.add('is-visible');
              target.querySelectorAll('[data-stagger-item]').forEach((item, index) => {
                if (item instanceof HTMLElement) item.style.setProperty('--stagger-index', String(index));
              });
              target.addEventListener('transitionend', () => target.classList.add('animation-complete'), { once: true });
              currentObserver.unobserve(target);
            });
          }, { threshold: 0.2, rootMargin: '0px 0px 15% 0px' });
          observer.observe(element);
        });

        document.querySelectorAll('[data-counter]').forEach((node) => {
          if (!(node instanceof HTMLElement) || node.dataset.counterReady === 'true') return;
          node.dataset.counterReady = 'true';
          const target = Number(node.dataset.counter || 0);
          if (!target) return;
          const observer = new IntersectionObserver((entries, currentObserver) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            currentObserver.disconnect();
            if (reducedMotion()) {
              node.textContent = String(target).padStart(2, '0');
              return;
            }
            const start = performance.now();
            const duration = 1200;
            const tick = (now: number) => {
              const progress = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              node.textContent = String(Math.round(target * eased)).padStart(2, '0');
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }, { threshold: 0.2, rootMargin: '0px 0px 15% 0px' });
          observer.observe(node);
        });

        const header = document.querySelector('[data-site-header]');
        if (header instanceof HTMLElement && header.dataset.scrollReady !== 'true') {
          header.dataset.scrollReady = 'true';
          let lastY = window.scrollY;
          let ticking = false;
          const update = () => {
            const currentY = window.scrollY;
            header.classList.toggle('is-scrolled', currentY > 80);
            header.classList.toggle('is-hidden', currentY > lastY && currentY > 160 && !header.classList.contains('menu-open'));
            lastY = currentY;
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) requestAnimationFrame(update);
            ticking = true;
          }, { passive: true });
          update();
        }

        const menuToggle = document.querySelector('[data-menu-toggle]');
        const mobileMenu = document.querySelector('[data-mobile-menu]');
        if (menuToggle instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement && menuToggle.dataset.ready !== 'true') {
          menuToggle.dataset.ready = 'true';
          menuToggle.addEventListener('click', () => {
            const open = menuToggle.getAttribute('aria-expanded') !== 'true';
            menuToggle.setAttribute('aria-expanded', String(open));
            menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
            mobileMenu.setAttribute('aria-hidden', String(!open));
            mobileMenu.toggleAttribute('inert', !open);
            header?.classList.toggle('menu-open', open);
            document.body.classList.toggle('menu-is-open', open);
          });
        }

        document.querySelectorAll('[data-language-picker]').forEach((picker) => {
          if (!(picker instanceof HTMLElement) || picker.dataset.ready === 'true') return;
          picker.dataset.ready = 'true';
          const button = picker.querySelector('[data-language-button]');
          if (!(button instanceof HTMLButtonElement)) return;
          button.addEventListener('click', () => {
            const open = button.getAttribute('aria-expanded') !== 'true';
            button.setAttribute('aria-expanded', String(open));
            picker.classList.toggle('is-open', open);
            const menu = picker.querySelector('[data-language-menu]');
            menu?.setAttribute('aria-hidden', String(!open));
            menu?.toggleAttribute('inert', !open);
          });
          document.addEventListener('click', (event) => {
            if (event.target instanceof Node && !picker.contains(event.target)) {
              button.setAttribute('aria-expanded', 'false');
              picker.classList.remove('is-open');
              const menu = picker.querySelector('[data-language-menu]');
              menu?.setAttribute('aria-hidden', 'true');
              menu?.setAttribute('inert', '');
            }
          });
        });

        document.body.classList.toggle('show-sticky', window.scrollY > 80);
        window.addEventListener('scroll', () => {
          document.body.classList.toggle('show-sticky', window.scrollY > 80);
        }, { passive: true });

        const visibleChecks = new Set<Element>();
        const checkObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => entry.isIntersecting ? visibleChecks.add(entry.target) : visibleChecks.delete(entry.target));
          document.body.classList.toggle('audit-in-view', visibleChecks.size > 0);
        }, { threshold: 0.05 });
        document.querySelectorAll('.website-check').forEach((check) => checkObserver.observe(check));

        if (!reducedMotion() && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          document.querySelectorAll('[data-magnetic]').forEach((button) => {
            if (!(button instanceof HTMLElement) || button.dataset.magneticReady === 'true') return;
            button.dataset.magneticReady = 'true';
            button.addEventListener('pointermove', (event) => {
              const box = button.getBoundingClientRect();
              const x = Math.max(-6, Math.min(6, (event.clientX - box.left - box.width / 2) / 8));
              const y = Math.max(-6, Math.min(6, (event.clientY - box.top - box.height / 2) / 8));
              button.style.transform = `translate3d(${x}px, ${y}px, 0)`;
            });
            button.addEventListener('pointerleave', () => {
              button.style.transition = `transform 400ms ${EXPO}`;
              button.style.transform = 'translate3d(0,0,0)';
              window.setTimeout(() => button.style.removeProperty('transition'), 420);
            });
          });
        }

        const ambient = document.querySelector('[data-ambient]');
        if (ambient instanceof HTMLElement && ambient.dataset.ready !== 'true' && !reducedMotion()) {
          ambient.dataset.ready = 'true';
          let ticking = false;
          const drift = () => {
            const rect = ambient.parentElement?.getBoundingClientRect();
            if (rect && rect.bottom > 0 && rect.top < window.innerHeight) {
              const offset = Math.max(-40, Math.min(40, -rect.top * 0.045));
              ambient.style.transform = `translate3d(0, ${offset}px, 0)`;
            }
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) requestAnimationFrame(drift);
            ticking = true;
          }, { passive: true });
          drift();
        }

        if (!window.plausible) {
          const plausible = ((...args: unknown[]) => {
            (plausible.q = plausible.q || []).push(args);
          }) as NonNullable<Window['plausible']>;
          plausible.q = [];
          window.plausible = plausible;
        }
        window.addEventListener('nexform:conversion', (event) => {
          const detail = (event as CustomEvent<{ name?: string }>).detail;
          window.plausible?.(detail?.name || 'conversion');
        });
      };

      document.addEventListener('astro:page-load', initPage);
      initPage();
    </script>
  </body>
</html>

<style is:global>
  ::view-transition-old(root) { animation: page-out 150ms ease-out both; }
  ::view-transition-new(root) { animation: page-in 300ms cubic-bezier(0.16, 1, 0.3, 1) both; }
</style>
