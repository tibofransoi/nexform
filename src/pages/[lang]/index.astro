---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebsiteCheck from '../../components/WebsiteCheck.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getContent } from '../../content/site';
import { landingCopy } from '../../content/landing';
import { publishedLocales, type PublishedLocale } from '../../i18n/config';

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

interface Props { locale: PublishedLocale }
const { locale } = Astro.props;
const siteCopy = getContent(locale);
const copy = landingCopy[locale];
---

<BaseLayout locale={locale} page="home" title={siteCopy.seo.home.title} description={siteCopy.seo.home.description}>
  <span slot="skip">{siteCopy.skip}</span>

  <div class="one-page">
    <section class="one-hero shell" aria-labelledby="hero-title">
      <h1 id="hero-title">{copy.hero.title}</h1>
      <p>{copy.hero.lead}</p>
      <div class="one-actions">
        <a class="button button-primary" href="#contact">{copy.hero.primary}<span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="#services">{copy.hero.secondary}</a>
      </div>
    </section>

    <section class="one-audit shell" id="website-check" aria-labelledby="audit-title">
      <div class="one-section-heading">
        <h2 id="audit-title">{copy.audit.title}</h2>
        <p>{copy.audit.copy}</p>
      </div>
      <WebsiteCheck locale={locale} id={`hero-check-${locale}`} compact />
    </section>

    <section class="one-section shell" id="services" aria-labelledby="services-title">
      <h2 id="services-title">{copy.services.title}</h2>
      <div class="one-service-grid">
        {copy.services.items.map((item, index) => (
          <article>
            <span>0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="one-section one-work" id="work" aria-labelledby="work-title">
      <div class="shell one-work-heading">
        <h2 id="work-title">{copy.work.title}</h2>
      </div>
      <div class="work-marquee" aria-label={copy.work.title}>
        <div class="work-track">
          {[0, 1].map((group) => (
            <div class="work-group" aria-hidden={group === 1 ? 'true' : undefined}>
              {copy.work.items.map((item) => (
                <article class="work-slide">
                  <img src={`${import.meta.env.BASE_URL}${item.image.replace(/^\//, '')}`} alt="" loading="lazy" width="1536" height="1024" />
                  <div><span>{item.label}</span><h3>{item.title}</h3></div>
                </article>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="one-section shell" id="method" aria-labelledby="process-title">
      <h2 id="process-title">{copy.process.title}</h2>
      <ol class="one-process">
        {copy.process.items.map((item, index) => (
          <li><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div></li>
        ))}
      </ol>
    </section>

    <section class="one-final" id="contact" aria-labelledby="contact-title">
      <div class="shell one-contact-grid">
        <div>
          <h2 id="contact-title">{copy.contact.title}</h2>
          <p>{copy.contact.copy}</p>
        </div>
        <ContactForm locale={locale} />
      </div>
    </section>
  </div>
</BaseLayout>
